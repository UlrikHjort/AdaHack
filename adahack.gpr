project Adahack is
   for Languages   use ("Ada", "C");
   for Source_Dirs use ("src");
   for Object_Dir  use "obj";
   for Exec_Dir    use ".";
   for Main        use ("adahack.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnat2012");
      for Default_Switches ("C")   use ("-g", "-O2");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ();
   end Linker;

end Adahack;
